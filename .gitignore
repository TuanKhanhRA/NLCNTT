# =============== #
# Unity .gitignore
# =============== #

# Thư mục build
[Bb]uild/
[Bb]uilds/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Mm]emoryCaptures/

# Logs và crash
*.log
*.stacktrace

# Visual Studio / Rider
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs

# Các file cache hoặc không cần thiết
*.pidb
*.booproj
*.svd
*.pdb
*.mdb

# Thư mục hệ điều hành
.DS_Store
Thumbs.db

# Unity generated meta and other system files
sysinfo.txt

# Auto-generated by Unity
/Logs/
*.apk
*.aab
*.xcuserstate
*.plist

# Unity Collaborate
.collab/

# Unity Cloud Build
.cloud/

# Rider project settings
*.sln.iml

# Crash and debug
*.dmp

# VSCode logs
.vscode/.history/

# Shader cache
*.shadercache

# JetBrains Rider
.idea/
*.ipr
*.iws

# Bản dịch localization tạm thời
*.pot

# Unity Asset Store tools
Assets/AssetStoreTools*

# Unity cache (đôi khi nằm ngoài project)
~/.cache/unity3d/
